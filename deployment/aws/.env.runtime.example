# Copy to .env.runtime, chmod 600, never commit or share.
# Domain must be under your control; register it first.
SA_DEMO_DOMAIN=preview.example.com
SA_PUBLIC_ORIGIN=https://preview.example.com
# Use 64+ hex characters from: openssl rand -hex 48
SA_CSRF_SECRET=REPLACE_WITH_96_HEX_CHARS
# Use 64 hex chars from: openssl rand -hex 32; retain it securely.
SA_MFA_KEY=REPLACE_WITH_64_HEX_CHARS
# Caddy bcrypt hash: encode the entire hash in SINGLE QUOTES to preserve $ characters.
# docker run --rm caddy:2.10.2-alpine caddy hash-password --plaintext 'unique-preview-password'
SA_DEMO_AUTH_HASH='REPLACE_WITH_CADDY_BCRYPT_HASH'
SA_REQUIRE_EVIDENCE_REFS=1
SA_REQUIRE_ADMIN_MFA=1
SA_REQUIRE_REVIEWED_LICENSE_EXPIRY=1
# Do NOT set SA_DEV_MAIL_OUTBOX=1 on an internet-accessible host.

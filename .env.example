# Example local settings; the application does not automatically load .env
PORT=3000
# DB_PATH=/absolute/path/to/streamatlas.db
# PRIVATE_PATH=/absolute/path/to/private
# SA_ADMIN_EMAIL=admin@example.test
# SA_ADMIN_PASSWORD=a-unique-long-local-development-password
# SA_CSRF_SECRET=replace-with-a-random-long-secret-in-production
# SA_REQUIRE_EVIDENCE_REFS=1   # require three internal references before publication (not proof)
# MEDIA_WORKER_MODE=inline     # debug only; default is supervised separate process
# SA_DISABLE_WORKER=1         # manual worker only: run npm run worker in another terminal
# TRUST_PROXY=1              # only behind trusted TLS reverse proxy that sanitizes headers

# SA_TRANSCODE_TIMEOUT_MS=90000 # Per-command processing timeout (10000–600000)
# SA_BROWSER_SCREENSHOTS=/absolute/folder # Optional browser smoke test screenshots

# Checkpoint 08 account-security additions
# SA_DEV_MAIL_OUTBOX=1        # DEVELOPMENT ONLY, writes single-use codes to data/private/mail-outbox/
# SA_MFA_KEY=<64 hex chars>   # persistent AES-256 key for encrypted authenticator secrets
# SA_REQUIRE_ADMIN_MFA=1      # require enrolled MFA for admin operations (automatic in production)
# SA_PUBLIC_ORIGIN=https://your-configured-host.example   # required in production
# SA_PROXY_TRUST_ACK=1        # only after validating reverse proxy's header sanitation
# NODE_ENV=production        # enables strict startup requirements, not equivalent to deployment readiness

# Checkpoint 26 safety controls
# SA_REQUIRE_DUAL_REVIEW=1  # two distinct administrator signoffs for AGE/CONSENT case closure; enforced automatically in production
# SA_REQUIRE_MALWARE_SCAN=1 # optional in local dev, mandatory automatically in production; requires ClamAV
# SA_CLAMSCAN_PATH=/usr/bin/clamscan
